    "Apply system theme to icon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将系统主题应用到图标"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply system theme to icon"
