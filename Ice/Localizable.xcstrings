    "Apply the current spacing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用当前间距"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the current spacing"
          }
        }
      }
    },
    "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用此设置会重新启动所有带菜单栏项目的 App。部分 App 可能需要手动重新启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched."
          }
        }
      }
    },
    "Automatically check for updates": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新"
