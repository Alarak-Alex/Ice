  "strings": {
    "Absolutely no personal information is collected or stored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不收集或存储任何个人信息。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolutely no personal information is collected or stored."
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "致谢"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acknowledgements"
          }
